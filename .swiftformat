# Written to agree with .swiftlint.yml. Every option here either implements a
# SwiftLint rule or stays out of its way.

--swift-version 6.0
--indent 4
--max-width 100
--trailing-commas always
--import-grouping alpha
--semicolons never
--allman false
--strip-unused-args closure-only
--empty-braces no-space

# Auto-fix what SwiftLint would otherwise only report, so those violations
# never reach a review.
--enable isEmpty,preferFirstWhere,preferContains,preferCountWhere
--enable preferFlatMap,preferMinOverSorted,unusedPrivateDeclarations

# Left to the author: these rewrite working code more aggressively than the
# consistency they buy is worth. Single-line bodies are idiomatic Swift, and
# hoistPatternLet reads worse for a single associated value.
--disable redundantSelf
--disable redundantReturn
--disable wrapMultilineStatementBraces
--disable blankLinesAroundMark
--disable wrapFunctionBodies
--disable wrapPropertyBodies
--disable wrapIfStatementBodies
--disable wrapLoopBodies
--disable hoistPatternLet
